{
  "name": "neon-brand-film",
  "version": "1.0.0",
  "private": true,
  "description": "NEON — Brand Film \"The Power of Ideas\" · 60 s · 9:16 · 1080x1920 · 60 fps",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "logo": "python3 scripts/trace_logo.py",
    "score": "python3 scripts/compose_score.py",
    "assets": "python3 scripts/make_textures.py",
    "stills": "node scripts/stills.mjs",
    "render:preview": "remotion render NeonBrandFilm out/neon-brand-film-preview.mp4 --scale=0.5 --crf=23",
    "render": "scripts/render_final.sh",
    "deliver": "scripts/deliver.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/three": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
